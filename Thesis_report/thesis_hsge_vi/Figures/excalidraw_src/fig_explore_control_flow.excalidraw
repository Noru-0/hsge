    {
      "id": "s3b_body",
      "type": "text",
      "x": 1115,
      "y": 390,
      "width": 350,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1d4ed8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
