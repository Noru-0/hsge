    {
      "id": "c5_ind_body",
      "type": "text",
      "x": 1270,
      "y": 185,
      "width": 240,
      "height": 175,
      "angle": 0,
      "strokeColor": "#701a75",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
