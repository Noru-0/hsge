# references/
# .claude/

# Secrets — never commit
.env
.env.*

# Cached WebArena login sessions (cookies == live session credentials)
.auth/

# Real-run artifacts — raw exploration/eval run dirs (episodes with
# per-step screenshots, checkpoints) are multi-GB and excluded. The
# curated eval results (outputs/eval/: per-task json + anomaly reports,
# no screenshots, 112 MB) are the eval proof and stay tracked.
outputs/*
!outputs/eval/

# Training checkpoints — LoRA adapters/optimizer states run to ~1.7 GB and
# individual files exceed GitHub's hard 100 MB per-file limit.
training/artifacts/

# Per-site train/val splits: ~42 MB of pure duplication, regenerated from the
# committed train_<site>.jsonl by training/prepare_dataset.py.
training/data/*/

# Superseded backup copies from the last manual dataset edit — pure
# duplication of the current train.jsonl/val.jsonl.
training_data/*.bak

# OS / editor / Python junk
.DS_Store
**/.DS_Store
__pycache__/
*.pyc

# LaTeX build artifacts (the PDFs and sources are tracked; these are not)
*.aux
*.bbl
*.blg
*.toc
*.lof
*.lot
*.out
*.synctex.gz
bibtex.log
build.log
texput.log

# Sample thesis used as a reference: a clone of a THIRD PARTY's repository
# (github.com/quockhanh41/thesis-report) with its own history and remote.
# Git can only record it as a broken gitlink here, and vendoring it in would
# copy someone else's work without attribution. Re-clone it if you need it.
Thesis_report/thesis_v3/
