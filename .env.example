# =============================================================================
# HSGE WebArena Configuration — copy to .env and fill in your keys
# =============================================================================

# --- WebArena URLs (BrowserGym uses WA_* prefix) ---
# Host the WebArena sites first (see docs/04_webarena_runbook.md)
BASE_URL=http://localhost
WA_SHOPPING=$BASE_URL:7770/
WA_SHOPPING_ADMIN=$BASE_URL:7780/admin
WA_REDDIT=$BASE_URL:9999
WA_GITLAB=$BASE_URL:8023
WA_WIKIPEDIA=$BASE_URL:8888/wikipedia_en_all_maxi_2022-05/A/User:The_other_Kiwix_guy/Landing
WA_MAP=$BASE_URL:3000
WA_HOMEPAGE=$BASE_URL:4399
WA_FULL_RESET=

# =============================================================================
# LLM PROVIDER — choose ONE preset below, or customize manually
# =============================================================================
# Set LLM_PROVIDER to: deepseek | openai | custom
LLM_PROVIDER=deepseek

# =============================================================================
# [Preset 1] DeepSeek (OpenAI-compatible, rẻ hơn, context 128K)
# =============================================================================
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# # deepseek-reasoner cũng có thể dùng cho solver nếu cần reasoning mạnh hơn:
# DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# =============================================================================
# [Preset 2] OpenAI
# =============================================================================
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# # Model mạnh hơn cho solver:
# OPENAI_STRONG_MODEL=gpt-4o

# =============================================================================
# Advanced: dùng model khác nhau cho Explorer và Solver
# =============================================================================
# Mặc định cả explorer và solver dùng chung 1 model.
# Để dùng model rẻ cho explorer & model mạnh cho solver, bỏ comment dòng dưới:
# EXPLORER_MODEL=gpt-4o-mini
# SOLVER_MODEL=gpt-4o

# =============================================================================
# Custom provider (bất kỳ OpenAI-compatible endpoint nào)
# =============================================================================
# LLM_PROVIDER=custom
# CUSTOM_API_KEY=sk-...
# CUSTOM_BASE_URL=https://your-endpoint/v1
# CUSTOM_MODEL=your-model-name

# =============================================================================
# WebArena test accounts (from web-arena-x/webarena repo)
# =============================================================================
# Shopping (OneStopShop): emma.lopez@gmail.com / Password.123
WA_ACCOUNT_SHOPPING_USERNAME=emma.lopez@gmail.com
WA_ACCOUNT_SHOPPING_PASSWORD=Password.123
# Shopping Admin: admin / admin1234
WA_ACCOUNT_ADMIN_USERNAME=admin
WA_ACCOUNT_ADMIN_PASSWORD=admin1234
# Reddit: MarvelsGrantMan136 / test1234
WA_ACCOUNT_REDDIT_USERNAME=MarvelsGrantMan136
WA_ACCOUNT_REDDIT_PASSWORD=test1234
# GitLab: byteblaze / hello1234
WA_ACCOUNT_GITLAB_USERNAME=byteblaze
WA_ACCOUNT_GITLAB_PASSWORD=hello1234